{
  "name": "flexpass-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FlexPass \u2014 client-side demo of a mobile-first gym member portal (real, camera-scannable QR check-in) and a separate staff front-desk dashboard.",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "dev:web": "vite",
    "dev:api": "npm --prefix server run dev",
    "setup": "npm run db:start && npm --prefix server run seed",
    "db:reset": "npm --prefix server run reset",
    "typecheck": "tsc -b && npm --prefix server run typecheck",
    "db:start": "./server/scripts/pgdev.sh start",
    "db:stop": "./server/scripts/pgdev.sh stop"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "lucide-react": "^0.462.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
