# Project-local cluster (npm run db:start) — no sudo needed.
DATABASE_URL=postgres://flexpass@127.0.0.1:55432/flexpass
# Or a system Postgres:
# DATABASE_URL=postgres://flexpass:flexpass@localhost:5432/flexpass
PORT=3000
# Server-side HMAC key for check-in tokens. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHECKIN_SIGNING_KEY=dev-only-change-me
SESSION_TTL_DAYS=30
